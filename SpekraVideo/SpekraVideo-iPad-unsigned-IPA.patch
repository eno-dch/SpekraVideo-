-      - name: Build unsigned IPA
+      - name: Build unsigned iOS app
         shell: bash
         run: |
           set -euo pipefail
+          xcodebuild -version
           xcodebuild \
             -project SpekraVideo.xcodeproj \
             -scheme SpekraVideo \
@@ -73,15 +29,43 @@ jobs:
             -sdk iphoneos \
             -destination 'generic/platform=iOS' \
             -derivedDataPath "$RUNNER_TEMP/DerivedData" \
+            ARCHS=arm64 \
             CODE_SIGNING_ALLOWED=NO \
             CODE_SIGNING_REQUIRED=NO \
             'CODE_SIGN_IDENTITY=' \
-            'TARGETED_DEVICE_FAMILY=1,2' \
             build
 
-          mkdir -p Payload
-          cp -R "$RUNNER_TEMP/DerivedData/Build/Products/OpenSource-iphoneos/SpekraVideo.app" Payload/
-          zip -qry SpekraVideo-unsigned.ipa Payload
+      - name: Verify and package unsigned IPA
+        shell: bash
+        run: |
+          set -euo pipefail
+          app="$RUNNER_TEMP/DerivedData/Build/Products/OpenSource-iphoneos/SpekraVideo.app"
+          executable="$app/SpekraVideo"
+          test "$(xcrun lipo -archs "$executable")" = arm64
+          xcrun vtool -show-build "$executable" | grep -E '^[[:space:]]*platform[[:space:]]+IOS$'
+
+          python3 - "$app/Info.plist" <<'PY'
+          import plistlib
+          import sys
+
+          with open(sys.argv[1], "rb") as file:
+              info = plistlib.load(file)
+          if 2 not in info.get("UIDeviceFamily", []):
+              sys.exit("The app must include the iPad device family in UIDeviceFamily")
+          if not info.get("NSCameraUsageDescription", "").strip():
+              sys.exit("The app must include NSCameraUsageDescription")
+          PY
+
+          if codesign --display "$app" 2>/dev/null; then
+            echo "::error::The application bundle is signed"
+            exit 1
+          fi
+          test ! -e "$app/embedded.mobileprovision"
+
+          mkdir Payload
+          cp -R "$app" Payload/
+          zip -qry --symlinks SpekraVideo-unsigned.ipa Payload
+          unzip -tq SpekraVideo-unsigned.ipa
 
       - name: Upload IPA
         uses: actions/upload-artifact@v4
